<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="AppAccentColor">#D97328</Color>
          <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}"/>
          <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#F4DFC9"/>
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F1ED"/>
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="CardBorderBrush" Color="#E1DCD4"/>
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#736C63"/>
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#ECE7E0"/>
          <SolidColorBrush x:Key="RowAltBrush" Color="#F9F7F3"/>
          <SolidColorBrush x:Key="WarningBrush" Color="#B8481F"/>
          <SolidColorBrush x:Key="OkBrush" Color="#3F7D4A"/>
          <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#28241F"/>
          <SolidColorBrush x:Key="StatusBarTextBrush" Color="#EFEAE2"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="AppAccentColor">#E8863C</Color>
          <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}"/>
          <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#3D2E1F"/>
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1B1A18"/>
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#242220"/>
          <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3733"/>
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#A79F94"/>
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#2C2925"/>
          <SolidColorBrush x:Key="RowAltBrush" Color="#211F1D"/>
          <SolidColorBrush x:Key="WarningBrush" Color="#FF8A5C"/>
          <SolidColorBrush x:Key="OkBrush" Color="#7FC488"/>
          <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#111010"/>
          <SolidColorBrush x:Key="StatusBarTextBrush" Color="#E9E4DC"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Icon geometries -->
      <StreamGeometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
      <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
      <StreamGeometry x:Key="IconDisk">M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12A3,3 0 0,0 9,15A3,3 0 0,0 12,18A3,3 0 0,0 15,15A3,3 0 0,0 12,12M6,6H15V10H6V6Z</StreamGeometry>
      <StreamGeometry x:Key="IconEdit">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</StreamGeometry>
      <StreamGeometry x:Key="IconCheck">M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12Z</StreamGeometry>
      <StreamGeometry x:Key="IconStar">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</StreamGeometry>
      <StreamGeometry x:Key="IconStarOutline">M22,9.24L14.81,8.63L12,2L9.19,8.63L2,9.24L7.45,13.97L5.82,21L12,17.27L18.18,21L16.54,13.97M12,15.4L8.24,17.67L9.24,13.39L5.92,10.5L10.3,10.13L12,6.1L13.71,10.13L18.09,10.5L14.77,13.39L15.77,17.67Z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14"/>
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.appTitle">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="0.4"/>
  </Style>
  <Style Selector="TextBlock.appSubtitle">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.sectionHeader">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="TextBlock.detailTitle">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="17"/>
  </Style>
  <Style Selector="TextBlock.warningText">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.toolbar">
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="Button.toolbar PathIcon">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.88"/>
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="6"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox, ComboBox">
    <Setter Property="CornerRadius" Value="6"/>
  </Style>

  <!-- DataGrid -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="RowHeight" Value="30"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="CanUserSortColumns" Value="False"/>
    <Setter Property="CanUserResizeColumns" Value="True"/>
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
    <Setter Property="Padding" Value="6,6"/>
  </Style>

  <!-- Tabs -->
  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="16,8"/>
  </Style>

  <!-- Status bar -->
  <Style Selector="Border.statusBar">
    <Setter Property="Background" Value="{DynamicResource StatusBarBackgroundBrush}"/>
  </Style>
  <Style Selector="Border.statusBar TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource StatusBarTextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="ProgressBar.statusBar">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
    <Setter Property="Background" Value="#3A362F"/>
  </Style>

</Styles>
