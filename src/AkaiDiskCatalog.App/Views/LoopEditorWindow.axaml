<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AkaiDiskCatalog.App.ViewModels"
        xmlns:controls="using:AkaiDiskCatalog.App.Controls"
        xmlns:convAv="using:Avalonia.Data.Converters"
        xmlns:conv="using:AkaiDiskCatalog.App.Converters"
        x:Class="AkaiDiskCatalog.App.Views.LoopEditorWindow"
        x:DataType="vm:LoopEditorViewModel"
        Title="{Binding Name, StringFormat='Edit Loop — {0}'}"
        Icon="/Assets/AppIcon.ico"
        Width="960" Height="580" MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <TextBlock Text="Zoom" VerticalAlignment="Center" Classes="subtle"/>
            <Slider Minimum="1" Maximum="100" Value="{Binding ZoomFactor}" Width="220" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ZoomFactor, StringFormat='{}{0:F0}x'}" VerticalAlignment="Center" Classes="subtle" Width="34"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0" HorizontalAlignment="Center">
                <TextBlock Text="Pitch" Classes="subtle" HorizontalAlignment="Center"/>
                <Slider Orientation="Vertical" Minimum="-24" Maximum="24" Value="{Binding PitchSemitones}"
                        TickFrequency="1" IsSnapToTickEnabled="True" Height="220" HorizontalAlignment="Center"
                        ToolTip.Tip="Preview only - varispeed pitch (speed and pitch change together, like a turntable), snapped to semitones. Not written when you save."/>
                <TextBlock Text="{Binding PitchSemitones, StringFormat='{}{0} st'}" Classes="subtle" HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Column="1" x:Name="WaveformScroll"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <controls:LoopWaveformEditControl Height="260"
                    LeftSamples="{Binding Left}" RightSamples="{Binding Right}"
                    LoopStart="{Binding LoopStart, Mode=TwoWay}" LoopEnd="{Binding LoopEnd, Mode=TwoWay}">
                    <controls:LoopWaveformEditControl.Width>
                        <MultiBinding Converter="{x:Static conv:ZoomWidthConverter.Instance}">
                            <Binding ElementName="WaveformScroll" Path="Bounds.Width"/>
                            <Binding Path="ZoomFactor"/>
                        </MultiBinding>
                    </controls:LoopWaveformEditControl.Width>
                </controls:LoopWaveformEditControl>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <TextBlock Text="{Binding LoopStart, StringFormat='Start: {0} samples'}"/>
                <TextBlock Text="{Binding LoopStartMs, StringFormat='({0:F0} ms)'}" Classes="subtle"/>
                <TextBlock Text="{Binding LoopEnd, StringFormat='End: {0} samples'}"/>
                <TextBlock Text="{Binding LoopEndMs, StringFormat='({0:F0} ms)'}" Classes="subtle"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Playback:" VerticalAlignment="Center"/>
                    <ComboBox SelectedItem="{Binding PlaybackMode}" VerticalAlignment="Center">
                        <ComboBox.Items>
                            <x:String>LOOP</x:String>
                            <x:String>LOOP-NOT-RELEASE</x:String>
                            <x:String>NOLOOP</x:String>
                        </ComboBox.Items>
                    </ComboBox>
                </StackPanel>

                <CheckBox Content="Hold (loop indefinitely)" IsChecked="{Binding IsHold}" VerticalAlignment="Center"
                          ToolTip.Tip="Writes the 9999 &quot;HOLD&quot; sentinel - the loop repeats for as long as the note sustains, with no fixed duration."/>

                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsHold}">
                    <TextBlock Text="Time (ms):" VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding TimeMsValue}" Minimum="0" Maximum="9998" Width="120" FormatString="0"
                                   ToolTip.Tip="Written to the sample for hardware/other tools to interpret. This app's own preview approximates it by looping for roughly this many milliseconds, then stopping - it doesn't emulate real crossfade DSP."/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Play always previews the current settings: NOLOOP plays the sample straight through once; a loop mode previews the loop per Hold/Time above."
                       Classes="subtle" TextWrapping="Wrap" MaxWidth="700"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="icon accent" Command="{Binding PlayPreviewCommand}" ToolTip.Tip="Play preview">
                    <PathIcon Data="{StaticResource IconPlay}"/>
                </Button>
                <Button Classes="icon" Command="{Binding StopPreviewCommand}" ToolTip.Tip="Stop"
                        IsVisible="{Binding IsPlayingPreview}">
                    <PathIcon Data="{StaticResource IconStop}"/>
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding SaveMessage}" Classes="warningText" TextWrapping="Wrap"
                       IsVisible="{Binding SaveMessage, Converter={x:Static convAv:ObjectConverters.IsNotNull}}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
