<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AkaiDiskCatalog.App.ViewModels"
        xmlns:models="using:AkaiDiskCatalog.App.Models"
        xmlns:controls="using:AkaiDiskCatalog.App.Controls"
        xmlns:conv="using:AkaiDiskCatalog.App.Converters"
        xmlns:convAv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="780"
        x:Class="AkaiDiskCatalog.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sampler Disk Catalog"
        Icon="/Assets/AppIcon.ico"
        Width="1240" Height="780" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:ProblemToBrushConverter x:Key="ProblemToBrush"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,18,20,12" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Data="{StaticResource IconDisk}" Width="22" Height="22"
                          Foreground="{DynamicResource AppAccentBrush}"/>
                <StackPanel Spacing="0">
                    <TextBlock Text="Sampler Disk Catalog" Classes="appTitle"/>
                    <TextBlock Text="S1000 / S900 diskette metadata browser" Classes="appSubtitle"/>
                </StackPanel>
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Folder" VerticalAlignment="Center" Margin="0,0,10,0" Classes="subtle"/>
                <TextBox Grid.Column="1" Text="{Binding FolderPath}" IsReadOnly="True" Margin="0,0,8,0"
                          Watermark="Choose a folder containing .hfe / .img disk images..."/>
                <Button Grid.Column="2" Classes="toolbar" Click="BrowseFolder_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconFolder}"/>
                        <TextBlock Text="Browse..."/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Classes="accent" Command="{Binding ScanFolderCommand}" IsEnabled="{Binding !IsScanning}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconRefresh}"/>
                        <TextBlock Text="Rescan"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Search / filter row -->
        <Border Grid.Row="1" Classes="card" Margin="20,0,20,12" Padding="12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                    <PathIcon Grid.Column="0" Data="{StaticResource IconSearch}" Width="15" Height="15"
                              Foreground="{DynamicResource SubtleTextBrush}" Margin="4,0,10,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                              Watermark="Search by file, sample, or program name..." Text="{Binding SearchText}"/>
                </Grid>
                <ComboBox Grid.Column="1" Margin="10,0,0,0" Width="160"
                          ItemsSource="{Binding KindFilters}" SelectedItem="{Binding SelectedKindFilter}"/>
                <ComboBox Grid.Column="2" Margin="10,0,0,0" Width="260"
                          ItemsSource="{Binding DiskFilters}" SelectedItem="{Binding SelectedDiskFilter}"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <TabControl Grid.Row="2" Margin="20,0,20,12">
            <TabItem Header="Files">
                <Grid ColumnDefinitions="2*,Auto,1*">
                    <Border Grid.Column="0" Classes="card" Padding="0">
                        <DataGrid ItemsSource="{Binding Results}"
                                  SelectedItem="{Binding SelectedFile}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="★" Width="40" MinWidth="40" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:FileRowViewModel">
                                            <Button Classes="icon" Padding="4" HorizontalAlignment="Center"
                                                    IsVisible="{Binding CanFavorite}"
                                                    Command="{Binding ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Toggle favorite">
                                                <Panel>
                                                    <PathIcon Data="{StaticResource IconStar}" Width="15" Height="15"
                                                              Foreground="#E8B84B" IsVisible="{Binding IsFavorite}"/>
                                                    <PathIcon Data="{StaticResource IconStarOutline}" Width="15" Height="15"
                                                              Foreground="{DynamicResource SubtleTextBrush}" IsVisible="{Binding !IsFavorite}"/>
                                                </Panel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Disk" Binding="{Binding DiskFileName}" Width="160" MinWidth="60"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="88" MinWidth="60"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" MinWidth="60"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="84" MinWidth="60"/>
                                <DataGridTextColumn Header="Rate" Binding="{Binding SampleRateDisplay}" Width="104" MinWidth="60"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="92" MinWidth="60"/>
                                <DataGridTextColumn Header="Playback mode" Binding="{Binding LoopDisplay}" Width="130" MinWidth="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="12" Background="Transparent"/>

                    <Border Grid.Column="2" Classes="card" Padding="0">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="14,14,14,0"
                                  IsVisible="{Binding SelectedFile, Converter={x:Static convAv:ObjectConverters.IsNotNull}}">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedFile.Name}" Classes="detailTitle"
                                           VerticalAlignment="Center" IsVisible="{Binding !IsEditingName}"/>
                                <TextBox Grid.Column="0" Text="{Binding EditNameText}" MaxLength="12"
                                         VerticalAlignment="Center" IsVisible="{Binding IsEditingName}"/>
                                <Button Grid.Column="1" Classes="icon" Command="{Binding BeginRenameNameCommand}"
                                        IsVisible="{Binding !IsEditingName}" Margin="8,0,0,0" ToolTip.Tip="Rename">
                                    <PathIcon Data="{StaticResource IconEdit}"/>
                                </Button>
                                <Button Grid.Column="2" Classes="icon accent" Command="{Binding ConfirmRenameNameCommand}"
                                        IsVisible="{Binding IsEditingName}" Margin="8,0,0,0" ToolTip.Tip="Save">
                                    <PathIcon Data="{StaticResource IconCheck}"/>
                                </Button>
                                <Button Grid.Column="3" Classes="icon" Command="{Binding CancelRenameNameCommand}"
                                        IsVisible="{Binding IsEditingName}" Margin="6,0,0,0" ToolTip.Tip="Cancel">
                                    <PathIcon Data="{StaticResource IconClose}"/>
                                </Button>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{Binding RenameMessage}" Classes="warningText" TextWrapping="Wrap"
                                       Margin="14,6,14,0"
                                       IsVisible="{Binding RenameMessage, Converter={x:Static convAv:ObjectConverters.IsNotNull}}"/>

                            <StackPanel Grid.Row="2" Margin="14,10,14,0" Spacing="6" IsVisible="{Binding Detail.IsSample}">
                                <TextBlock Text="Waveform" Classes="sectionHeader"/>
                                <TextBlock Text="Loading audio..." Classes="subtle" FontStyle="Italic"
                                           IsVisible="{Binding IsLoadingSampleAudio}"/>
                                <controls:WaveformView Height="120"
                                    LeftSamples="{Binding SampleAudio.Left}"
                                    RightSamples="{Binding SampleAudio.Right}"
                                    Loops="{Binding SampleAudio.Loops}"
                                    IsVisible="{Binding SampleAudio, Converter={x:Static convAv:ObjectConverters.IsNotNull}}"/>
                                <TextBlock Text="{Binding SampleAudio.PartnerName, StringFormat='Stereo pair with: {0}'}" Classes="subtle"
                                           IsVisible="{Binding SampleAudio.IsStereo}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding SampleAudio, Converter={x:Static convAv:ObjectConverters.IsNotNull}}">
                                    <Button Classes="icon accent" Command="{Binding PlaySampleCommand}" ToolTip.Tip="Play">
                                        <PathIcon Data="{StaticResource IconPlay}"/>
                                    </Button>
                                    <Button Classes="icon" Command="{Binding PlaySampleWithLoopCommand}" ToolTip.Tip="Play with loop"
                                            IsVisible="{Binding SampleAudio.HasLoop}">
                                        <PathIcon Data="{StaticResource IconLoop}"/>
                                    </Button>
                                    <Button Classes="icon" Command="{Binding StopSampleCommand}" ToolTip.Tip="Stop"
                                            IsVisible="{Binding IsPlayingSample}">
                                        <PathIcon Data="{StaticResource IconStop}"/>
                                    </Button>
                                    <Button Classes="icon" Click="EditLoop_Click" ToolTip.Tip="Edit loop">
                                        <PathIcon Data="{StaticResource IconEdit}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <Panel Grid.Row="3">
                            <TextBlock Text="Select a file to see its details" Classes="subtle"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedFile, Converter={x:Static convAv:ObjectConverters.IsNull}}"/>
                            <ScrollViewer IsVisible="{Binding SelectedFile, Converter={x:Static convAv:ObjectConverters.IsNotNull}}">
                            <StackPanel DataContext="{Binding Detail}" x:DataType="models:SelectedFileDetail"
                                        Spacing="2" Margin="14,10,14,14">
                                <TextBlock Text="{Binding Source.DiskFileName, StringFormat='Disk: {0}'}" Classes="subtle"/>
                                <TextBlock Text="{Binding Source.SampleRateHz, StringFormat='Sample rate: {0} Hz'}" IsVisible="{Binding IsSample}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Source.DurationMs, StringFormat='Duration: {0:F1} ms'}" IsVisible="{Binding IsSample}"/>
                                <TextBlock Text="{Binding Source.RootKey, StringFormat='Root key: {0}'}" IsVisible="{Binding IsSample}"/>
                                <TextBlock Text="{Binding Source.PlaybackMode, StringFormat='Playback mode: {0}'}" IsVisible="{Binding IsSample}"/>
                                <TextBlock Text="{Binding Source.NumKeygroups, StringFormat='Keygroups: {0}'}" IsVisible="{Binding IsProgram}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Source.MidiChannel, StringFormat='MIDI channel: {0}'}" IsVisible="{Binding IsProgram}"/>
                                <TextBlock Text="{Binding Source.ParseWarning, StringFormat='⚠ {0}'}" Classes="warningText"
                                           IsVisible="{Binding Source.HasWarning}" Margin="0,8,0,0"/>

                                <StackPanel IsVisible="{Binding HasLoops}" Margin="0,14,0,0">
                                    <TextBlock Text="Loop points" Classes="sectionHeader"/>
                                    <DataGrid ItemsSource="{Binding Loops}" AutoGenerateColumns="False" IsReadOnly="True"
                                              Height="200">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="34" MinWidth="30"/>
                                            <DataGridTextColumn Header="At" Binding="{Binding At}" Width="90" MinWidth="40"/>
                                            <DataGridTextColumn Header="Length" Binding="{Binding LengthSamples}" Width="90" MinWidth="40"/>
                                            <DataGridTextColumn Header="Time (ms)" Binding="{Binding TimeDisplay}" Width="100" MinWidth="40"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>

                                <TextBlock Text="No loop points defined for this sample" FontStyle="Italic" Classes="subtle"
                                           IsVisible="{Binding HasNoLoops}" Margin="0,14,0,0"/>

                                <TextBlock Text="Program not decoded for S3000 keygroups" FontStyle="Italic" Classes="subtle"
                                           IsVisible="{Binding ProgramKeygroupsUnparsed}" Margin="0,14,0,0"/>

                                <StackPanel IsVisible="{Binding IsProgram}" Spacing="10" Margin="0,4,0,0">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Keygroups" Classes="sectionHeader"/>
                                        <DataGrid ItemsSource="{Binding Keygroups}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  Height="180">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="36" MinWidth="30"/>
                                                <DataGridTextColumn Header="Key range" Binding="{Binding KeyRange}" Width="110" MinWidth="40"/>
                                                <DataGridTextColumn Header="Filter" Binding="{Binding Filter}" Width="80" MinWidth="40"/>
                                                <DataGridTextColumn Header="VelXF" Binding="{Binding VelocityCrossfade}" Width="80" MinWidth="40"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Velocity zones (sample map)" Classes="sectionHeader"/>
                                        <DataGrid ItemsSource="{Binding VelocityZones}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  Height="280">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="KG" Binding="{Binding KeygroupNumber}" Width="64" MinWidth="30"/>
                                                <DataGridTextColumn Header="Vel" Binding="{Binding VelocityRange}" Width="86" MinWidth="40"/>
                                                <DataGridTextColumn Header="Sample" Binding="{Binding SampleName}" Width="150" MinWidth="40"/>
                                                <DataGridTextColumn Header="Tune(c/s)" Binding="{Binding CentsTune}" Width="98" MinWidth="40"/>
                                                <DataGridTextColumn Header="Loud" Binding="{Binding Loudness}" Width="78" MinWidth="40"/>
                                                <DataGridTextColumn Header="Filter" Binding="{Binding Filter}" Width="76" MinWidth="40"/>
                                                <DataGridTextColumn Header="Pan" Binding="{Binding Pan}" Width="72" MinWidth="40"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                            </Panel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Disks">
                <Border Classes="card" Padding="0">
                    <DataGrid ItemsSource="{Binding Disks}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="220" MinWidth="60"/>
                            <DataGridTextColumn Header="Volume" Binding="{Binding VolumeName}" Width="150" MinWidth="60"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="70" MinWidth="50"/>
                            <DataGridTextColumn Header="Density" Binding="{Binding Density}" Width="100" MinWidth="60"/>
                            <DataGridTemplateColumn Header="Status" Width="260" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:DiskRowInfo">
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                                                   Foreground="{Binding HasProblem, Converter={StaticResource ProblemToBrush}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="3" Classes="statusBar" Padding="20,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Classes="statusBar" Width="180" Height="6" Minimum="0" Maximum="1"
                             Value="{Binding ScanProgressFraction}" IsVisible="{Binding IsScanning}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
